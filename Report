local aiDragging, aiDragStart, aiStartPos

aiBar.InputBegan:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then

		aiDragging = true

		aiDragStart = input.Position

		aiStartPos = aiFrame.Position

		input.Changed:Connect(function()

			if input.UserInputState == Enum.UserInputState.End then

				aiDragging = false

			end

		end)

	end

end)

UserInputService.InputChanged:Connect(function(input)

	if aiDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then

		local delta = input.Position - aiDragStart

		aiFrame.Position = UDim2.new(aiStartPos.X.Scale, aiStartPos.X.Offset + delta.X, aiStartPos.Y.Scale, aiStartPos.Y.Offset + delta.Y)

	end

end)

